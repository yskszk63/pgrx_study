{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/refs/heads/main/schemas/devContainer.base.schema.json",
  "image": "mcr.microsoft.com/devcontainers/rust",
  "features": {
    "ghcr.io/yskszk63/features/pgrx:0.1.2": "0.16.1"
  },
  "mounts": [
    {
      "type": "bind",
      "target": "/home/vscode/.pgrx/",
      "source": "${localWorkspaceFolder}/.pgrx"
    }
  ]
}
